    "log_level": "INFO"
  },
  "framework_config": {
    "path": "/bench/config/baselines/baseline_vector-rag.json",
    "sha256": "975141ce7f9d4f68c44a98a348def56e14a1beab2d85abb0126a038e0947aae8",
    "format": "json",
    "profile": "vector-rag-v1"
  },
  "dataset": {
