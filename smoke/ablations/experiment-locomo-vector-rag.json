        "requested_model": "gpt-4.1",
        "parameters": {
          "temperature": 0,
          "max_tokens": 4096,
          "reasoning_effort": "low"
        },
        "runtime": {
          "timeout_seconds": 120,
          "rpm": 200,
          "max_retries": 5,
          "response_max_retries": 1
        }
      }
    ]
