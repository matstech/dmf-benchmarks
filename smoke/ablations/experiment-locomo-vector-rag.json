      "*"
    ],
    "filters": {
      "categories": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "seed": 7
  },
  "models": {
    "answerer": {
      "provider": "openai",
      "requested_model": "gpt-4.1-mini",
