    "sampling": {
      "fraction": 0.005,
      "unit": "conversation",
      "seed": 7,
      "rounding": "ceil"
    },
    "source": "https://raw.githubusercontent.com/snap-research/locomo/3eb6f2c585f5e1699204e3c3bdf7adc5c28cb376/data/locomo10.json",
    "revision": "3eb6f2c585f5e1699204e3c3bdf7adc5c28cb376"
