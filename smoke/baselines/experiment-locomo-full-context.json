    "log_level": "INFO"
  },
  "framework_config": {
    "path": "/bench/config/baselines/baseline_full-context.json",
    "sha256": "e8bb5f563bba40a16080835a8f1a650875bc2e70e7dd96a66fe9b698955af24e",
