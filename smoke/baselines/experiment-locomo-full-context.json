        "requested_model": "qwen2.5:0.5b",
        "parameters": {
          "temperature": 0,
          "max_tokens": 256
        },
        "runtime": {
          "timeout_seconds": 120,
          "rpm": 120,
          "max_retries": 0,
          "response_max_retries": 1
        }
      }
