      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "dmf_bench_run_progress_ratio",
          "legendFormat": "{{benchmark}}/{{framework}}/{{protocol}} units"
        },
        {
          "expr": "dmf_bench_run_item_progress_ratio",
          "legendFormat": "{{benchmark}}/{{framework}}/{{protocol}} items"
        }
      ],
      "title": "Run progress",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "dmf_bench_run_phase_active == 1",
          "legendFormat": "{{phase}}"
        },
        {
          "expr": "dmf_bench_run_state_active == 1",
          "legendFormat": "state={{state}}"
        }
      ],
      "title": "Active phase",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "rate(dmf_bench_llm_requests_total[5m])",
          "legendFormat": "{{role}}/{{provider}}/{{outcome}}"
        },
        {
          "expr": "rate(dmf_bench_llm_tokens_total[5m])",
          "legendFormat": "{{role}}/{{provider}}/{{token_type}} tokens"
        }
      ],
      "title": "LLM requests and tokens",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "rate(dmf_bench_qdrant_client_operations_total[5m])",
          "legendFormat": "{{operation}}/{{outcome}}"
        },
        {
          "expr": "up{job=\"qdrant\"}",
          "legendFormat": "qdrant up"
        }
      ],
      "title": "Qdrant client and server",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "rate(dmf_bench_artifact_publish_total[5m])",
          "legendFormat": "{{backend}}/{{outcome}}"
        }
      ],
      "title": "Artifact publish",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "rate(dmf_bench_attempts_total[5m])",
          "legendFormat": "{{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(dmf_bench_phase_duration_seconds_bucket[5m]))",
          "legendFormat": "phase p95"
        }
      ],
      "title": "Attempts and durations",
      "type": "timeseries"
    }
