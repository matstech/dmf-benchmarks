{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "dmf_bench_persisted_run_completed_input_records / clamp_min(dmf_bench_persisted_run_expected_input_records, 1)",
          "legendFormat": "{{benchmark}}/{{framework}} input records"
        },
        {
          "expr": "dmf_bench_persisted_run_progress_ratio",
          "legendFormat": "{{benchmark}}/{{framework}} evaluation items"
        }
      ],
      "title": "Run progress",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "dmf_bench_persisted_run_state == 1",
          "legendFormat": "state={{state}}"
        }
      ],
      "title": "Run state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "id": 3,
      "targets": [
        {
          "expr": "dmf_bench_persisted_run_llm_tokens",
          "legendFormat": "persisted {{benchmark}}/{{framework}} {{role}} {{token_type}}"
        },
        {
          "expr": "dmf_bench_llm_tokens_total{job=\"benchmark\"}",
          "legendFormat": "live {{role}}/{{provider}} {{token_type}}"
        }
      ],
      "title": "LLM token usage",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "rate(dmf_bench_qdrant_client_operations_total{job=\"benchmark\"}[$__rate_interval])",
          "legendFormat": "{{operation}}/{{outcome}}"
        },
        {
          "expr": "up{job=\"qdrant\"}",
          "legendFormat": "qdrant up"
        }
      ],
      "title": "Qdrant client and server",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "dmf_bench_persisted_run_result",
          "legendFormat": "{{benchmark}}/{{framework}} {{evaluator}} {{metric}}"
        }
      ],
      "title": "Evaluation results",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "dmf_bench_persisted_run_execution_seconds",
          "legendFormat": "{{benchmark}}/{{framework}} execution"
        },
        {
          "expr": "dmf_bench_persisted_run_pipeline_duration_seconds",
          "legendFormat": "{{benchmark}}/{{framework}} {{stage}}"
        }
      ],
      "title": "Execution and pipeline time",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "dmf",
    "benchmarks"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "DMF Benchmarks",
  "uid": "dmf-benchmarks",
  "version": 2,
  "weekStart": ""
